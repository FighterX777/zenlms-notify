# Copy this file to .env and fill in your values
# Never commit .env to git

EMAIL=your-email-id
PASSWORD=your-password

# Telegram Bot (get from @BotFather on Telegram)
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Your Telegram chat/user ID (get from @userinfobot)
CHAT_ID=987654321

# Optional flags
# DRY_RUN=true   # Print messages without sending to Telegram
# DEBUG=true     # Enable verbose debug logging
